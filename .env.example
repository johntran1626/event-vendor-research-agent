# Variable names only. Never put values in this file.
# Copy what you need into a git-ignored .env.local and fill in the values there.

# Pipeline in agent/ (agent/store.py reads these).
# Goes in .env.local at the repo root.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Web app in web/.
# Goes in web/.env.local. Never put the secret key in a NEXT_PUBLIC_ variable: those are sent to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
